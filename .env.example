# Required for story generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Story/media
NUM_EPISODES=5
IMAGES_PER_EPISODE=8
IMAGE_SEED=42
ART_STYLE=cinematic illustrated digital painting, warm dramatic lighting, semi-realistic, muted film grain, high detail

# Voice
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+8%

# Video
FPS=25
VIDEO_CRF=20
VIDEO_PRESET=medium
TAIL_SECONDS=0.6
CROSSFADE_SECONDS=0.20
MUSIC_VOLUME=0.10

# Better captions (optional; requires faster-whisper)
WHISPER_ENABLED=0
WHISPER_MODEL=base

# Optional local image-to-video adapter
I2V_ENABLED=0
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/i2v_workflow.json
I2V_CLIP_SECONDS=4
I2V_TIMEOUT_SECONDS=180
